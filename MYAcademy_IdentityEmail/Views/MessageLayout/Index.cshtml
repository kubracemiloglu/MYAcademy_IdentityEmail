@{
    Layout = ViewData["UseCourseLayout"] is true ? null : "_VeloraLayout";
}

@if (ViewData["UseCourseLayout"] is true)
{
<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_MessageLayoutStyleComponentPartial")
<body>

    @await Component.InvokeAsync("_MessageLayoutSidebarComponentPartial")

    <div class="app-main">

        @await Component.InvokeAsync("_MessageLayoutNavbarComponentPartial")

      @RenderBody()
    </div>

    @await Component.InvokeAsync("_MessageLayoutScriptComponentPartial")
</body>
</html>
}
else
{
    @RenderBody()
}

