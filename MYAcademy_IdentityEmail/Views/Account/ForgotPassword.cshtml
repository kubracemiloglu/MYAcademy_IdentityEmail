@model EmailRequestViewModel
@{ Layout = "_VeloraPublicLayout"; ViewData["Title"] = "Şifremi Unuttum"; }
<span class="v-badge">Hesabına yeniden bağlan</span><h1>Şifreni mi unuttun?</h1><p class="v-muted">E-posta adresini yaz; şifreni yenilemen için güvenli bir bağlantı gönderelim.</p><form method="post" asp-action="ForgotPassword"><div asp-validation-summary="All" class="v-validation" role="alert"></div><div class="v-field"><label asp-for="Email">E-posta adresin</label><input asp-for="Email" class="form-control" type="email" autocomplete="email" /><span asp-validation-for="Email"></span></div><button class="v-btn" type="submit">Sıfırlama bağlantısı gönder</button></form><div class="v-auth-bottom"><a asp-controller="Login" asp-action="SignIn">Giriş ekranına dön</a></div>
