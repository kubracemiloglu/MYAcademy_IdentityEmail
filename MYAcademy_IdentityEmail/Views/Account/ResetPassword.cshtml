@model ResetPasswordViewModel
@{ Layout = "_VeloraPublicLayout"; ViewData["Title"] = "Yeni Şifre"; }
<span class="v-badge">Güvenli bir başlangıç</span><h1>Yeni şifreni belirle.</h1><p class="v-muted">En az 6 karakter; büyük harf, küçük harf, rakam ve özel karakter kullan.</p><form method="post" asp-action="ResetPassword"><div asp-validation-summary="All" class="v-validation" role="alert"></div><input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" /><div class="v-field"><label asp-for="Password">Yeni şifren</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span></div><div class="v-field"><label asp-for="ConfirmPassword">Yeni şifreni tekrarla</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="v-btn" type="submit">Şifreyi yenile</button></form><div class="v-auth-bottom"><a asp-action="ForgotPassword">Yeni bir sıfırlama bağlantısı iste</a></div>
