@model EmailRequestViewModel
@{ Layout = "_VeloraPublicLayout"; ViewData["Title"] = "Yeni Doğrulama Kodu"; }
<span class="v-badge">Bağlantıyı tamamla</span><h1>Yeni bir kod iste.</h1><p class="v-muted">Kayıt olurken kullandığın e-posta adresini yaz. Yeniden gönderimler arasında en az 1 dakika bekle.</p><form method="post" asp-action="ResendVerification"><div asp-validation-summary="All" class="v-validation" role="alert"></div><div class="v-field"><label asp-for="Email">E-posta adresin</label><input asp-for="Email" class="form-control" type="email" autocomplete="email" /><span asp-validation-for="Email"></span></div><button class="v-btn" type="submit">Doğrulama kodu gönder</button></form><div class="v-auth-bottom"><a asp-controller="Login" asp-action="SignIn">Giriş ekranına dön</a></div>
