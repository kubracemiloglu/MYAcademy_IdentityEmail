@model ChangePasswordViewModel
@{ Layout = "_VeloraLayout"; ViewData["Title"] = "Şifremi Değiştir"; }
<section class="v-panel v-content-panel"><div class="v-profile-card"><div class="v-page-title"><div><h1>Şifreni değiştir</h1><p>Hesabın için güçlü, benzersiz bir şifre seç.</p></div></div><form method="post" asp-action="ChangePassword"><div asp-validation-summary="All" class="v-validation" role="alert"></div><div class="v-field"><label asp-for="CurrentPassword">Mevcut şifren</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div><div class="v-field"><label asp-for="Password">Yeni şifren</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><small class="v-field-help">En az 6 karakter; büyük harf, küçük harf, rakam ve özel karakter.</small><span asp-validation-for="Password"></span></div><div class="v-field"><label asp-for="ConfirmPassword">Yeni şifreni tekrarla</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><div class="v-form-footer"><button class="v-btn" type="submit">Şifreyi güncelle</button><a class="v-btn v-btn-secondary" asp-action="Index">Profilime dön</a></div></form></div></section>
