@model ProfileViewModel
@using MYAcademy_IdentityEmail.Helpers
@{ Layout = "_VeloraLayout"; ViewData["Title"] = "Profilim"; }
<section class="v-panel v-content-panel"><div class="v-profile-card"><div class="v-page-title"><div><span class="v-badge">Sana ait bir alan</span><h1 style="margin-top:14px">Profilim</h1><p>Kendini tanıt. Bilgilerini güncel tut.</p></div></div>
<div class="v-profile-heading"><span class="v-avatar v-avatar-lg">@if (Model.ImageUrl?.StartsWith("/uploads/avatars/", StringComparison.Ordinal) == true) { <img src="@Model.ImageUrl" alt="Profil fotoğrafınız" /> } else { @VeloraDisplay.Initials(Model.Name + " " + Model.Surname) }</span><div><h2>@Model.Name @Model.Surname</h2><div class="v-muted">@Model.Email</div><small class="v-muted">@@@Model.UserName</small></div></div>
<form method="post" enctype="multipart/form-data" asp-action="Index"><div asp-validation-summary="All" class="v-validation" role="alert"></div><div class="v-form-grid"><div class="v-field"><label asp-for="Name">Adın</label><input asp-for="Name" class="form-control" autocomplete="given-name" /><span asp-validation-for="Name"></span></div><div class="v-field"><label asp-for="Surname">Soyadın</label><input asp-for="Surname" class="form-control" autocomplete="family-name" /><span asp-validation-for="Surname"></span></div><div class="v-field v-full"><label asp-for="Photo">Profil fotoğrafı</label><input asp-for="Photo" type="file" class="form-control" accept="image/png,image/jpeg" /><span asp-validation-for="Photo"></span><small class="v-field-help">PNG veya JPEG · En fazla 2 MB</small></div></div><div class="v-form-footer"><button class="v-btn" type="submit">Değişiklikleri kaydet</button><a class="v-btn v-btn-secondary" asp-action="ChangePassword"><i class="bi bi-shield-lock"></i>Şifremi değiştir</a></div></form>
</div></section>
